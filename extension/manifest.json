{
  "manifest_version": 3,
  "name": "Kendali – Browser MCP",
  "version": "0.2.0",
  "description": "Let AI agents (Claude Code, Codex, Gemini CLI, Cursor, OpenCode…) control this browser through a local MCP server.",
  "homepage_url": "https://github.com/aswadwk/kendali",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Kendali",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "downloads",
    "cookies",
    "history",
    "storage",
    "alarms",
    "identity",
    "identity.email",
    "contentSettings"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
